# Copy to .env.local and fill in. Never commit real values.

# Agent worker (agents/). Every setting and its default: agents/README.md#environment.
# ANTHROPIC_API_KEY=             # Claude for the agents; without it they use saved answers (agents/cache/claude) or fallbacks
# GG_LIVE_SOURCES=1              # npm --prefix agents start reads RePORTER, USAspending and the cancellation list (keep off for the scripted demo); =list reads only the cancellation list (what the hosted worker uses)
# GG_DB=local                    # local (module in-process on sim/seed.json) | spacetime (a SpacetimeDB server: GG_SPACETIME_URI, GG_SPACETIME_DB)

# Web app (web/, Vite reads VITE_* at build time). All optional.
# VITE_BACKEND=live              # live (default: SpacetimeDB, falls back to local seed if unreachable) | local (in-memory sim/seed.json, no server)
# VITE_STDB_URI=ws://localhost:3000   # SpacetimeDB server the web app connects to
# VITE_STDB_DB=grantguard        # database (module) name on that server

# Cancellation-list scraper (scrapers/, T15) and the fund tracker that reads it. All optional.
# APIFY_TOKEN=                   # Apify API token (@nathan has the account); only to run/publish the Actor in the cloud, or for the tracker to read a cloud dataset
# GG_APIFY_ACTOR=nathanqiu~nih-grant-cancellation-list  # the tracker (agents/) reads this Actor's latest successful run (recommended; needs APIFY_TOKEN); Check now in the web app starts a fresh run first (~8 s, ~$0.03) when GG_LIVE_SOURCES=1
# GG_APIFY_DATASET=              # Apify dataset id pinning one cloud run (overrides GG_APIFY_ACTOR); the tracker (agents/) then reads it instead of the local file
# GG_CANCELLATIONS_FILE=         # scraper output file, written by scrapers/ and read by agents/ (default scrapers/out/cancellations.json)
# GG_LAB_GRANTS=                 # comma-separated lab grant IDs: the scraper keeps only these, and the tracker saves only these in agents/cache/ (default: the whole list)
# GG_SCRAPE_SOURCE=live          # live | saved (bundled saved copy, works offline)
