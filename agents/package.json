{
  "name": "grantguard-agents",
  "private": true,
  "type": "module",
  "description": "GrantGuard agent worker (Track B): three agents, each with its own database identity",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "demo": "tsx src/main.ts --demo",
    "test": "GG_CLAUDE=off GG_PRICE_CATALOG=test/fixtures/prices.json node --import tsx --test test/*.test.ts",
    "test:spacetime": "GG_SPACETIME_IT=1 GG_CLAUDE=off GG_PRICE_CATALOG=test/fixtures/prices.json node --import tsx --test test/spacetime.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "spacetimedb": "2.13.0",
    "zod": "^4.6.7"
  }
}
